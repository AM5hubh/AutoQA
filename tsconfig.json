{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "apps/api/**/*.ts",
    "apps/demo-site/**/*.ts",
    "packages/**/*.ts",
    "workers/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "infra/**/*.ts",
    "*.ts"
  ]
}
