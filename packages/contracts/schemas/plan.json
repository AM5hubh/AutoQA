      "maxItems": 5,
      "minItems": 1,
      "title": "Tests",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Limitations",
      "type": "array"
    }
