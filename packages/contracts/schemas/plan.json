            "type": "string"
          },
          "maxItems": 5,
          "title": "Preconditions",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Assumptions",
          "type": "array"
        },
        "steps": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Navigate"
              },
              {
                "$ref": "#/$defs/Click"
              },
              {
                "$ref": "#/$defs/Fill"
              },
              {
                "$ref": "#/$defs/Select"
              },
              {
                "$ref": "#/$defs/Check"
              },
              {
                "$ref": "#/$defs/AssertVisible"
              },
              {
                "$ref": "#/$defs/AssertText"
              },
              {
                "$ref": "#/$defs/AssertURL"
              },
              {
                "$ref": "#/$defs/Screenshot"
              }
            ]
          },
          "maxItems": 15,
          "minItems": 2,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "requirement",
        "priority",
        "preconditions",
        "assumptions",
        "steps"
      ],
      "title": "TestCase",
      "type": "object"
