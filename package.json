{
  "name": "autoqa-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run dev --workspace @autoqa/web",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch workers/browser-worker/src/main.ts",
    "dev:demo": "tsx watch apps/demo-site/server.ts",
    "db:generate": "prisma generate --schema packages/database/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/database/schema.prisma",
    "user:create": "tsx apps/api/src/provision.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @autoqa/web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run build --workspace @autoqa/web",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-slot": "^1.2.0",
    "ajv": "^8.17.1",
    "argon2": "^0.44.0",
    "bullmq": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.5",
    "nodemailer": "^10.4.0",
    "oauth4webapi": "^3.8.8",
    "pg": "^8.16.0",
    "playwright": "1.65.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22.12"
  }
}
